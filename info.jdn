{:name "loopy"
 :version "DEVEL"
 :description "An HTTP and WebSocket server for Janet"
 :author "Michael Camilleri"
 :license "GPL-2.0-only"
 :url "https://github.com/pyrmont/loopy"
 :repo "git+https://github.com/pyrmont/loopy.git"
 :dependencies []
 :vendored [{:name "mongoose"
             :url "https://github.com/cesanta/mongoose"
             # Pinned: Mongoose is GPL-2.0-only and determines this
             # bundle's licence, so upgrades must be deliberate
             :tag "7.22"
             :prefix "deps/mongoose"
             :paths ["mongoose.c"
                     "mongoose.h"
                     "LICENSE"]}
            {:name "testament"
             :url "https://github.com/pyrmont/testament"
             :prefix "deps/testament"
             :paths ["lib/testament.janet"
                     "init.janet"
                     "LICENSE"]}]
 :artifacts {:executables []
             :libraries []
             :manpages []
             :natives [{:name "loopy"
                        # Our binding code; Mongoose is vendored third
                        # party code and lives under deps/
                        :files ["src/loopy.c"
                                "deps/mongoose/mongoose.c"]
                        # middleware must precede server: server.janet
                        # references middleware.janet's `middleware`
                        :embedded ["lib/middleware.janet"
                                   "lib/server.janet"]
                        # -I lets src/loopy.c find mongoose.h under deps/.
                        # glibc hides alloca and struct ip_mreq, both of
                        # which Mongoose uses, unless _DEFAULT_SOURCE is
                        # set: the build compiles as c99, and glibc reads
                        # __STRICT_ANSI__ as a request for neither.
                        # Mongoose's built-in TLS offers a single hardcoded
                        # cipher suite rather than negotiating one, and
                        # defaults to ChaCha20-Poly1305, which Windows
                        # Schannel does not implement. AES-128-GCM is
                        # supported everywhere.
                        :cflags {:common ["-DMG_TLS=MG_TLS_BUILTIN"
                                          "-DMG_ENABLE_CHACHA20=0"
                                          "-Ideps/mongoose"]
                                 :posix ["-D_DEFAULT_SOURCE"]}}]
             :scripts []}}
